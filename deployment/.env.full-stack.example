# Full Stack Environment Configuration
# Copy this file to .env.full-stack and fill in your values

# Service Configuration
WORKERS=1
THREADS=8

# Deployment Mode
DEPLOYMENT_MODE=local

# Service URLs (override defaults to use container names in Docker network)
ENCODER_SERVICE_URL=http://encoder-service:8082
MODEL_SERVICE_URL=http://model-service:8083
MERGER_SERVICE_URL=http://merger-service:8084
OBSTRUCTION_SERVICE_URL=http://obstruction-service:8081
STATS_SERVICE_URL=http://stats-service:8085

# Model S3 access (Scaleway private bucket)
MODEL_URL_TEMPLATE=s3://your-bucket-name/models/{name}.onnx
# Specs are fetched from s3://{bucket}/{name}/spec.json by default — set SPEC_URL_TEMPLATE to override
SCW_ACCESS_KEY=your-scaleway-access-key
SCW_SECRET_KEY=your-scaleway-secret-key
SCW_REGION=your-region
SCW_ENDPOINT_URL=https://s3.your-region.your-provider.cloud

# ── Public API auth (inbound) ────────────────────────────────────────────────
# none = open; token = require Bearer API_TOKEN; auth0 = validate Auth0 JWTs.
# For the web daylight tool's login + quota, use auth0. AUTH0_* are PUBLIC
# identifiers (not secrets); AUTH0_AUDIENCE must equal the Auth0 API Identifier
# AND the frontend's VITE_AUTH0_AUDIENCE.
AUTH_TYPE=none
# AUTH_TYPE=auth0
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_AUDIENCE=https://api.service.com

# ── Rate limit: 10 predictions per rolling 24 h (for the web tool) ───────────
# Enforced on /run, /run/detailed, /simulate; keyed on the Auth0 subject (sub),
# IP fallback. Counter lives in the co-located `redis` service (shared across
# gunicorn workers).
RATE_LIMIT_ENABLED=false
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_DAY=10
# Separate, generous ceiling for supporting compute endpoints (obstruction/encode/
# stats/…). A normal run makes several such calls, so keep this well above
# PER_DAY × calls-per-run. 0 = don't guard them.
RATE_LIMIT_AUX_PER_DAY=300
# Length of the rolling window (hours) — the counter's TTL. 24 = "10 per 24 h".
RATE_LIMIT_WINDOW_HOURS=24
# The co-located `redis` service (see the compose file) is the shared counter;
# RATE_LIMIT_REDIS_URL defaults to redis://redis:6379 there, so leave this unset
# unless you point at an external Redis.
# RATE_LIMIT_REDIS_URL=redis://redis:6379
# Only the web app's Auth0 client id is limited; the Revit add-in (different
# client id) stays unlimited on the SAME /run endpoint. Empty = limit everyone.
# RATE_LIMIT_CLIENT_ID=<LUX Web SPA client id>

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Logging
LOG_LEVEL=INFO

# Performance Optimizations
CUDA_VISIBLE_DEVICES=-1
TF_CPP_MIN_LOG_LEVEL=3
OPENCV_IO_ENABLE_OPENEXR=0
OMP_NUM_THREADS=1
