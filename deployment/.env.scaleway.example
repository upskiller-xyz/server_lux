# Scaleway full-stack deployment — Modal inference + internal-only services.
#
# NON-SECRET config only. The CI deploy (.github/workflows/deploy-scaleway.yml)
# renders the .env.scaleway used at runtime by APPENDING secrets from GitHub
# Secrets to this template — so no secret values live in the repo and nothing is
# edited by hand on the box.
#
# Secrets injected by CI (do NOT add them here): MODAL_KEY, MODAL_SECRET,
# API_TOKEN, SCW_ACCESS_KEY, SCW_SECRET_KEY. Set them in GitHub → Settings →
# Secrets and variables → Actions.
#
# For a manual/local deploy instead, copy this to .env.scaleway and add the
# secret values yourself (.env.scaleway is gitignored).

# ── Inference on Modal ───────────────────────────────────────────────────────
# Point at the deployed Modal endpoint. A *.modal.run host is auto-detected and
# server-lux attaches Modal-Key / Modal-Secret proxy-auth headers automatically.
# In CI, override this with the `MODEL_SERVICE_URL` GitHub Variable.
MODEL_SERVICE_URL=https://<workspace>--upskiller-model-inferenceservice-web.modal.run

# ── Public API auth (inbound, optional) ──────────────────────────────────────
# none = open (Community); token = require `Authorization: Bearer <API_TOKEN>`;
# auth0 = validate Auth0-issued JWTs (Bearer) against the tenant's JWKS.
# AUTH_TYPE has no default: it must be chosen explicitly (compose refuses to
# start otherwise), so a missing variable can never publish an open API.
# AUTH_TYPE=token requires a non-empty API_TOKEN (server refuses to start).
# Set AUTH_TYPE via the `AUTH_TYPE` GitHub Variable; API_TOKEN via GitHub Secrets.
# AUTH_TYPE=auth0

# Auth0 (only when AUTH_TYPE=auth0). These are PUBLIC identifiers, not secrets —
# set them as GitHub Variables (the CI deploy renders them). lux validates the
# JWT signature/audience/issuer; it never needs an Auth0 client secret (it is the
# resource server, not a token-requesting client). issuer + JWKS URL are derived
# from AUTH0_DOMAIN. AUTH0_ALGORITHMS is optional (default RS256).
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_AUDIENCE=https://api.your-service/
# AUTH0_ALGORITHMS=RS256

# ── Per-user daily rate limit (10/day for the web tool) ──────────────────────
# Enforced on /v1/simulate, keyed on the Auth0 subject (sub). Set these as
# GitHub Variables; RATE_LIMIT_REDIS_URL is a SECRET (Scaleway Managed Redis
# rediss:// URL) — inject via GitHub Secrets, never commit it. A shared Redis is
# required in production so the count is correct across serverless instances.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_DAY=10             # predictions per rolling window (/run, /simulate)
# RATE_LIMIT_WINDOW_HOURS=24        # rolling window length (the counter's TTL)
# RATE_LIMIT_AUX_PER_DAY=300        # ceiling for obstruction/encode/stats/… (0 = off)
# Counter defaults to the co-located `redis` service (redis://redis:6379, set in
# the compose). Only set RATE_LIMIT_REDIS_URL to point at an external Managed
# Redis (rediss://) — as a GitHub Secret, never committed.
# RATE_LIMIT_REDIS_URL=  (GitHub Secret)
# Limit ONLY the web app's Auth0 client; Revit (different client id) stays
# unlimited on the same /run endpoint. Empty = limit every authenticated caller.
# RATE_LIMIT_CLIENT_ID=<LUX Web SPA client id>  (GitHub Variable)
# The IP fallback (unauthenticated/no-sub callers) reads X-Forwarded-For.
# The gateway nginx resolves the real client IP from Cloudflare's
# CF-Connecting-IP and OVERWRITES X-Forwarded-For with it, so the compose
# default of 1 hop is correct for this stack.
# RATE_LIMIT_TRUSTED_PROXY_HOPS=1
# Swagger UI (/docs/, /apispec.json) is off on the public gateway by default.
# API_DOCS_ENABLED=false

# ── Obstruction: off-box on a Scaleway Serverless Container ───────────────────
# Moved off the VM — bursty CPU-bound load (64 directions/window) saturated the
# instance's fixed cores. Deployed separately as a Scaleway Serverless Container
# (see server_obstruction); that deploy prints the URL + token. The .scw.cloud
# host is auto-detected → X-Auth-Token attached.
# OBSTRUCTION_SERVICE_URL is a PUBLIC identifier (GitHub Variable); the token is a
# SECRET (OBSTRUCTION_TOKEN via GitHub Secrets — do NOT commit it here). The token
# is per-service (<SERVICE>_TOKEN), so a future Scaleway container gets its own key.
OBSTRUCTION_SERVICE_URL=https://<name>-<hash>.functions.fnc.fr-par.scw.cloud
# Backpressure — keep == the container's max-scale.
OBSTRUCTION_MAX_CONCURRENCY=10

# ── Per-service repo ref (deploy-scaleway.sh) ─────────────────────────────────
# Pins each microservice's own repo to a branch or tag, instead of always
# tracking whatever its default branch currently points to.
#
# deploy-scaleway.sh resolves each service's ref in this order:
#   1. <NAME>_REF below. In a CI deploy these come from the GitHub Variables
#      ENCODER_REF / MERGER_REF / STATS_REF, which the workflow renders on
#      EVERY run — overridden, for its own run only, by the service_ref input
#      a tag deploy passes.
#   2. deployment/services/.deployed-refs — what this box last deployed for
#      that service. This is why a tag dispatch's pin is not lost on the next
#      deploy, even though the runtime env file is rebuilt from scratch.
#   3. "master".
#
# A successful tag deploy writes the GitHub Variable itself (needs the
# DEPLOY_VARS_TOKEN secret), so the pin ends up in (1) and survives the box
# being rebuilt — (2) is the fallback for when that write is not configured or
# not permitted. Set a Variable by hand to pin a service without cutting a tag,
# or to roll back to an earlier one.
#
# A raw commit SHA is not supported — deploy-scaleway.sh uses
# `git clone --branch` / `git fetch <ref>`, which both require a branch or tag.
# ENCODER_REF=master
# MERGER_REF=master
# STATS_REF=master

# ── Per-service resources & workers ──────────────────────────────────────────
LUX_WORKERS=2
LUX_THREADS=8
LUX_CPUS=2
LUX_MEM=2g

ENCODER_WORKERS=2
ENCODER_THREADS=4
ENCODER_CPUS=2
ENCODER_MEM=2g

MERGER_WORKERS=2
MERGER_THREADS=4
MERGER_CPUS=1
MERGER_MEM=1g

STATS_WORKERS=1
STATS_THREADS=4
STATS_CPUS=1
STATS_MEM=1g

# ── Performance / runtime tuning (CPU-only box) ──────────────────────────────
CUDA_VISIBLE_DEVICES=-1
TF_CPP_MIN_LOG_LEVEL=3
OMP_NUM_THREADS=1
LOG_LEVEL=INFO

# ── Scaleway Container Registry (OPTIONAL) ───────────────────────────────────
# The default deploy builds images on the instance (deploy-scaleway.sh supports
# only --build and --firewall) and does NOT use a registry. These are only for a
# separate build/push workflow; leave unset for the standard on-box build.
# SCW_REGISTRY=rg.fr-par.scw.cloud/your-namespace
# SCW_REGISTRY_USER=nologin
# Registry auth would use SCW_SECRET_KEY (inject via GitHub Secrets if you add such a flow).

# ── [call]-record persistence (OPTIONAL) ────────────────────────────────────
# The tracing records ([call] JSONL) survive a deploy only when written outside
# the container. Set CALL_RECORDS_BUCKET to enable: records are buffered in the
# app, flushed to CALL_RECORDS_DIR (bind-mounted to /var/log/lux on the host) and
# yesterday's closed file is uploaded to the Scaleway Object Storage bucket each
# flush cycle. Unset = stdout only (a deploy wipes them — see the observability
# plan, step 4). The bucket must exist; creds come from SCW_ACCESS_KEY/SECRET_KEY
# (already injected as GitHub Secrets for the full-stack model bucket).
# CALL_RECORDS_BUCKET=call-records
# CALL_RECORDS_DIR=/var/log/lux/call-records
# CALL_RECORDS_FLUSH_SECONDS=30
